# kwits-api - Spring Boot backend for kwits-mobile
#
# Copy to .env and fill in real values. Never commit .env.
# spring-dotenv reads this file at startup, so no shell exports are needed --
# the same developer experience as kwits-mobile.

SERVER_PORT=8080

# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
# Base URL of the Supabase instance. For local dev this is the API port from
# supabase/config.toml. `supabase start` in this directory prints it.
SUPABASE_URL=http://127.0.0.1:54321

# Publishable ("anon") key, sent as the apikey header on Auth REST calls.
# Printed by `supabase status` as the anon/publishable key.
SUPABASE_ANON_KEY=

# The secret Supabase signs its access tokens with. kwits-api only VERIFIES
# tokens with this -- it never issues tokens of its own. Printed by
# `supabase status` as "JWT secret".
#
# This assumes symmetric HS256, which is what local Supabase uses because
# supabase/config.toml leaves signing_keys_path commented out. If a hosted
# project signs asymmetrically instead, this variable becomes unnecessary --
# see the JWT DECODER comment in config/SecurityConfig.java.
SUPABASE_JWT_SECRET=

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Postgres inside the local Supabase stack. Port 54322 comes from the [db]
# section of supabase/config.toml. `supabase status` prints the DB URL.
SPRING_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:54322/postgres
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# ---------------------------------------------------------------------------
# Not needed yet: CORS
# ---------------------------------------------------------------------------
# A React Native app does not enforce CORS, so the Android/iOS clients need no
# configuration here. Only add CORS if you start serving the app via Expo web
# (`expo start --web`), which does run in a browser.
